# Server-side PostgreSQL connection. Never prefix this with NEXT_PUBLIC_.
# Local development uses the Docker database below. Production uses the hosted
# PostgreSQL connection string provided by the deployment platform.
DATABASE_URL=postgresql://salikha:salikha_local_dev_only@127.0.0.1:55432/salikha

# Google Calendar is intentionally disabled for the first demo deployment.
# Do not add these variables until the core app is fully deployed and verified.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:3001/api/google-calendar/callback
GOOGLE_CALENDAR_TOKEN_ENCRYPTION_KEY=
APP_ORIGIN=http://localhost:3001
