# Local-only PostgreSQL connection. Never prefix this with NEXT_PUBLIC_.
DATABASE_URL=postgresql://salikha:salikha_local_dev_only@127.0.0.1:55432/salikha

# Optional local Google Calendar integration (create OAuth Web application credentials)
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:3001/api/google-calendar/callback
GOOGLE_CALENDAR_TOKEN_ENCRYPTION_KEY=
APP_ORIGIN=http://localhost:3001
